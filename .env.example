NODE_ENV=development
PORT=5000

# Supabase PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres?pgbouncer=true

# Comma-separated frontend origins allowed to call this API with credentials.
# Local example:
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Production example for Render:
# CORS_ORIGINS=https://your-vercel-app.vercel.app,https://your-custom-domain.com

JWT_SECRET=replace-with-a-long-random-secret

# Local HTTP should use COOKIE_SECURE=false and COOKIE_SAME_SITE=lax.
# Render/Vercel HTTPS cross-site cookies should use COOKIE_SECURE=true and COOKIE_SAME_SITE=none.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
